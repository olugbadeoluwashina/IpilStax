{
  "name": "@ipinstaq/backend",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-env --allow-net --allow-read --env-file=.env main.ts"
  },
  "imports": {
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@ipinstaq/core/": "./src/core/",
    "@ipinstaq/infra/": "./src/infra/",
    "@ipinstaq/shared/": "./src/shared/",

    "kysely": "npm:kysely@^0.28.10",
    "pg": "npm:pg@^8.17.1",
    "pg-pool": "npm:pg-pool@^3.11.0",
    "zod": "npm:zod@^4.3.5",
    
    "@std/assert": "jsr:@std/assert"
  },

  "lint": {
    "exclude": ["src/tests/"]
  },

  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  }
}
