{
  "name": "@ipinstaq/backend",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "db:migrate": "deno run --allow-all --env-file=.env src/infra/persistence/migrate.ts",
    "migrate:down": "deno run --allow-all --env-file=.env src/infra/persistence/migrate.ts down",
    "pre-flight": "deno test && deno task db:migrate",
    "dev": "deno run --allow-all --watch --env main.ts"
  },
  "imports": {
    "@db/postgres": "jsr:@db/postgres@^0.19.5",
    "@ipinstaq/core/": "./src/core/",
    "@ipinstaq/infra/": "./src/infra/",
    "@ipinstaq/shared/": "./src/shared/",

    "kysely": "npm:kysely@^0.28.10",
    "pg": "npm:pg@^8.17.1",
    "pg-pool": "npm:pg-pool@^3.11.0",
    "zod": "npm:zod@^4.3.5",

    "@std/assert": "jsr:@std/assert",
    "@std/expect": "jsr:@std/expect",
    "@std/path": "jsr:@std/path",
    "@std/testing": "jsr:@std/testing"
  },

  "lint": {
    "exclude": ["src/tests/"]
  },

  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true
  }, 
  "test": {
    "include": ["tests/**/*.test.ts", "tests/"]
  }
}
